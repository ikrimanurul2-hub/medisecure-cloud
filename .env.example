# =========================================================
# MEDISECURE CLOUD ENVIRONMENT EXAMPLE
# Project : MediSecure Cloud
# Purpose : Cloud Computing + Keamanan Jaringan
# =========================================================

# =========================================================
# APPLICATION CONFIG
# =========================================================

APP_NAME=MediSecure Cloud
APP_ENV=development
APP_PORT=5000
APP_URL=http://localhost:5000

FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
AI_SERVICE_URL=http://localhost:8000

# =========================================================
# DATABASE CONFIG - POSTGRESQL
# =========================================================

DB_HOST=postgres
DB_PORT=5432
DB_NAME=medisecure_db
DB_USER=medisecure_user
DB_PASSWORD=medisecure_password

# =========================================================
# JWT / SESSION SECURITY CONFIG
# =========================================================

JWT_SECRET=change_this_with_strong_secret_key
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=change_this_refresh_secret_key
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=10

# =========================================================
# CORS CONFIG
# =========================================================

CORS_ORIGIN=http://localhost:5173

# =========================================================
# RATE LIMIT CONFIG
# =========================================================

RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=100

LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5

# =========================================================
# FILE UPLOAD CONFIG
# =========================================================

MAX_FILE_SIZE_MB=5
ALLOWED_FILE_TYPES=application/pdf,image/png,image/jpeg
ALLOWED_FILE_EXTENSIONS=pdf,png,jpg,jpeg

UPLOAD_TEMP_DIR=uploads/tmp

# =========================================================
# GOOGLE CLOUD STORAGE CONFIG
# Object Storage Multi-Cloud
# Compute utama menggunakan AWS, sedangkan object storage menggunakan GCP.
# =========================================================

GCP_PROJECT_ID=your-gcp-project-id
GCP_BUCKET_NAME=your-gcp-bucket-name
GCP_KEY_FILE=./gcp-service-account.json

# =========================================================
# AI SERVICE CONFIG
# Bisa menggunakan Gemini API, Hugging Face API, atau rule-based AI service.
# Untuk MVP awal, AI service bisa dibuat lokal dengan FastAPI.
# =========================================================

AI_PROVIDER=local
GEMINI_API_KEY=your-gemini-api-key
HUGGINGFACE_API_KEY=your-huggingface-api-key

# =========================================================
# SECURITY LOGGING CONFIG
# =========================================================

LOG_LEVEL=info
ENABLE_ACTIVITY_LOG=true
ENABLE_SECURITY_ALERT=true

# =========================================================
# WAZUH CONFIG
# =========================================================

WAZUH_MANAGER_HOST=wazuh-manager
WAZUH_MANAGER_PORT=1514

# =========================================================
# SURICATA CONFIG
# =========================================================

SURICATA_LOG_PATH=/var/log/suricata/eve.json

# =========================================================
# TELEGRAM ALERT CONFIG
# Untuk notifikasi alert keamanan dari Wazuh/Suricata.
# =========================================================

TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# =========================================================
# DOCKER CONFIG
# =========================================================

POSTGRES_CONTAINER_NAME=medisecure-postgres
BACKEND_CONTAINER_NAME=medisecure-backend
FRONTEND_CONTAINER_NAME=medisecure-frontend
AI_CONTAINER_NAME=medisecure-ai-service

# =========================================================
# AWS CONFIG
# Compute utama akan menggunakan AWS.
# =========================================================

AWS_REGION=ap-southeast-1
AWS_ECR_REPOSITORY=medisecure-cloud
AWS_EC2_HOST=your-ec2-public-ip
AWS_EC2_USER=ubuntu